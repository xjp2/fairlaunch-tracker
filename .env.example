# Copy this file to `.env` and fill in an RPC URL for each chain you want
# live. Every value below has a safe default (an idle listener that logs a
# warning) if left blank, so the stack starts and the dashboard works even
# before you wire up every feed. See tracker.py's module docstring for the
# full research/confidence notes behind each contract address below.

LOG_LEVEL=INFO
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000
DATA_DIR=/app/data

# ---------------------------------------------------------------------------
# Solana
# ---------------------------------------------------------------------------
# Pump.fun's public firehose. Real, documented, no key required — this is
# the correct default, only change it if PumpPortal's endpoint changes.
PUMPPORTAL_WS_URL=wss://pumpportal.fun/api/data

# StonkFun and wallet-buy monitoring both run on plain Solana RPC
# subscriptions (logsSubscribe + getTransaction), not a proprietary API, so
# they share this one URL. Get a free WS endpoint from Helius, QuickNode, or
# Triton. StonkFun's on-chain program ID / platform-config accounts are
# already hardcoded in tracker.py (MEDIUM-HIGH confidence — see docstring).
SOLANA_WS_RPC_URL=

# Tried only after the primary above fails/errors (e.g. a plan's quota
# exhausted) — a free public endpoint, not a real substitute for a dedicated
# plan. Softens outages for cheap calls (getAccountInfo); most free RPCs
# disable getProgramAccounts outright, so this won't fully cover holder
# counts during a prolonged primary outage.
SOLANA_FALLBACK_RPC_URL=https://api.mainnet-beta.solana.com

# Ember: HIGH confidence, no key/RPC needed. It's not WebSocket at all — it's
# Server-Sent Events, found by pulling embercurve.fun's production JS bundle
# and grepping it for endpoint strings. This default is correct as-is.
EMBER_FEED_URL=https://embercurve.fun/api/solana/feed

# ---------------------------------------------------------------------------
# BNB Chain
# ---------------------------------------------------------------------------
# A BSC WebSocket RPC endpoint. Chainstack has a confirmed permanent free
# tier with WebSockets included (3M req/mo, 25 req/s, no card required) —
# use that. Ankr's free tier is HTTPS-only (WS is paid-plan only, useless
# for eth_subscribe). QuickNode's "free tier" is really a 7-day trial.
# Required for Four.meme/Flap.sh AND for BNB wallet-buy monitoring.
BNB_WS_RPC_URL=

# Four.meme: HIGH confidence. TokenManager2 V2, confirmed by 3 independent
# sources; full TokenCreate event ABI sourced from four-meme-ai's GitHub docs
# and hardcoded into a dedicated decoder (decode_four_meme_token_create).
FOUR_MEME_FACTORY_ADDRESS=0x5c952063c7fc8610FFDB798152D69F0B9550762b
FOUR_MEME_EVENT_SIGNATURE=TokenCreate(address,address,uint256,string,string,uint256,uint256,uint256)

# Flap.sh: MEDIUM confidence on this address (official docs.flap.sh "Portal"
# contract). LOW confidence on the event's exact param layout — no full ABI
# was found, so this falls back to a generic best-effort decoder. Verify on
# BscScan before trusting decoded name/symbol/dev fields in production.
FLAP_FACTORY_ADDRESS=0xe2cE6ab80874Fa9Fa2aAE65D277Dd6B8e65c9De0
FLAP_EVENT_SIGNATURE=TokenCreated(address,address,string,string,uint256)

# ---------------------------------------------------------------------------
# Robinhood Chain (real network — Ethereum L2 on Arbitrum, chain ID 4663,
# mainnet since 2026-07-01, explorer at robinhoodchain.blockscout.com)
# ---------------------------------------------------------------------------
# An RPC WebSocket endpoint for Robinhood Chain (QuickNode/Alchemy/Chainstack
# all publish one; see their Robinhood Chain RPC guides). Required for Pons,
# Long.xyz, AND Robinhood-chain wallet-buy monitoring.
ROBINHOOD_WS_RPC_URL=

# Pons: HIGH confidence. The topic0 hash quoted in Bitquery's docs was
# independently recomputed with keccak256 in this project and matched
# exactly — strong evidence the address/signature below are correct.
PONSFAMILY_FACTORY_ADDRESS=0x7ed598bcef8bd9edd8c97a195c6d13f40801ec7e
PONSFAMILY_EVENT_SIGNATURE=TokenLaunched(address,address,address,address,uint256,uint256)

# Long.xyz: NOT RESOLVED. Its entry contract is called "LongLauncher" but no
# verified address was found. Check robinhoodchain.blockscout.com against a
# known long.xyz launch transaction, or ask their docs/support, then paste
# the address here — it'll use the same generic decoder as Flap.sh.
LONGXYZ_FACTORY_ADDRESS=
LONGXYZ_EVENT_SIGNATURE=TokenCreated(address,address,string,string,uint256)

# ---------------------------------------------------------------------------
# Market data (DexScreener public API — no key required)
# ---------------------------------------------------------------------------
DEXSCREENER_API_BASE=https://api.dexscreener.com

# ---------------------------------------------------------------------------
# Filtering engine tunables
# ---------------------------------------------------------------------------
SPAM_WINDOW_SECONDS=86400
SPAM_THRESHOLD=3
NARRATIVE_DECAY_SECONDS=180
NARRATIVE_ACCEL_RATIO=2.5
CONVICTION_WINDOW_SECONDS=180
CONVICTION_MULTIPLIER=3.0
HIVE_MIND_WINDOW_SECONDS=180
HIVE_MIND_MIN_WALLETS=2
# Minimum token age before the buy/sell-ratio "buy pressure" scoring signal is
# trusted — a brand-new token's ratio is lopsided toward buys simply because
# nobody has had time to sell yet, not because demand is durable.
BUY_PRESSURE_MIN_AGE_SECONDS=600

# ---------------------------------------------------------------------------
# Post-trade feedback loop
# ---------------------------------------------------------------------------
TARGET_MARKET_CAP_USD=100000
# Mcap alone is gameable — a handful of large/wash trades can push it up with
# no real participants behind it. GRADUATED requires all of these together.
MIN_GRADUATION_VOLUME_USD=20000
MIN_GRADUATION_LIQUIDITY_USD=5000
MIN_GRADUATION_TXNS=50
MIN_GRADUATION_VOLUME_TO_MCAP_RATIO=0.15
MIN_GRADUATION_AGE_SECONDS=120
MAX_GRADUATION_BUY_SELL_SKEW=10.0
RUG_WINDOW_SECONDS=600
RUG_DRAWDOWN_PCT=0.9
POST_TRADE_POLL_INTERVAL=20
STATE_SNAPSHOT_INTERVAL=60

# Hard floor for the Top Opportunities panel — no signal outranks "this has
# basically no real market activity yet." Matches MIN_GRADUATION_VOLUME_USD's
# ballpark: real graduations have been observed as low as ~$26k mcap, so a
# $40k floor was silently zero-scoring genuinely successful tokens.
MIN_OPPORTUNITY_MARKET_CAP_USD=28000
MIN_OPPORTUNITY_VOLUME_USD=500

# Pump.fun bonding curve (decoded directly from the on-chain account, free)
PUMPFUN_BONDING_CURVE_SOL_TARGET=85

# Data-integrity tripwire: a WATCHING pump.fun token (still on its bonding
# curve, not yet migrated) can't legitimately have a mcap anywhere near this —
# used to catch "new token create" events whose mint actually belongs to an
# already-established, unrelated token (confirmed: real xStocks tokens like
# AAPLx/TSLAx showing up as if freshly launched).
PUMPFUN_IMPLAUSIBLE_WATCHING_MCAP_USD=200000

# --- Block established coins / tokenized stocks being treated as new launches ---
# A genuinely brand-new fair launch can't already be at this mcap on any platform.
IMPLAUSIBLE_NEW_LAUNCH_MCAP_USD=1000000
# Known established symbols to hard-block (comma-separated, case-insensitive).
# xStocks-style tickers (MSTRx, AAPLx, TSLAx...) are auto-detected separately.
ESTABLISHED_SYMBOL_BLOCKLIST=HYPE,ZEC,BTC,ETH,SOL,BNB,XRP,DOGE,SHIB,PEPE,WIF,BONK,USDC,USDT,LINK,ADA,AVAX,TRX,TON,SUI,APT,ARB,OP,MSTR
# ---------------------------------------------------------------------------
# Telegram opportunity pings — sends a rich message (image, mcap, volume,
# holders, dev reputation, full score reasoning) the first time a WATCHING
# token's opportunity score crosses TELEGRAM_OPPORTUNITY_SCORE_THRESHOLD.
# Both blank = feature silently disabled, no startup requirement.
# CHAT_ID can't be looked up from the token alone — message the bot at least
# once, then fetch it via: curl "https://api.telegram.org/bot<TOKEN>/getUpdates"
# and take .result[0].message.chat.id from the response.
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_OPPORTUNITY_SCORE_THRESHOLD=60

# Early Momentum ping — separate score field/threshold, gated to the same
# $50k-$200k band the dashboard's Early Momentum panel filters to (keep in
# sync with EARLY_MOMENTUM_MIN_MCAP/MAX_MCAP in static/dashboard.html).
TELEGRAM_EARLY_MOMENTUM_SCORE_THRESHOLD=55
EARLY_MOMENTUM_PING_MIN_MCAP_USD=50000
EARLY_MOMENTUM_PING_MAX_MCAP_USD=200000

# Mock Portfolio (paper trading) — simulates buying this many dollars the
# instant a coin is first flagged as an opportunity, purely to show "would
# this have been a good buy" as mcap moves from there. No real funds.
MOCK_BUY_SIZE_USD=100

# ---------------------------------------------------------------------------
# TypeSafe "Jev" semantic reasoner (optional — blank key = silently disabled)
# ---------------------------------------------------------------------------
# Jev (TypeSafe's System One model) judges the QUALITATIVE things the scoring
# arithmetic can't: is the launch coherent/serious, is it impersonating an
# established asset, does the theme have staying power. Its calibrated judgment
# is blended into the opportunity score as confidence-scaled, attributed points
# (see compute_opportunity_score) and shown per-token on the dashboard.
#
# Jev does NOT learn on its own — it's a stateless reasoner. The learning loop
# lives in THIS system: every judgment is logged with the token's eventual
# outcome (mooned/rugged) and the "Jev Decision Stats" panel shows which
# dimensions actually track winners on your data.
#
# Get a key at typesafe.ai. COST NOTE: Jev calls cost tokens. The gating +
# caps below keep spend bounded for a small credit balance — only promising,
# identifiable candidates ever cost a call, each is evaluated once and cached,
# and calls stop entirely once a cap is hit (tokens then score on the
# deterministic signals only, exactly as if no key were set).
TYPESAFE_API_KEY=
TYPESAFE_API_BASE=https://api.typesafe.ai
TYPESAFE_MODEL=jev-latest
JEV_REQUEST_TIMEOUT=20
JEV_MAX_RETRIES=3

# --- Cost controls (tune these for your budget) ---
# Only spend a Jev call on a candidate that has ALREADY cleared these bars on
# the deterministic signals — keeps cheap/obvious tokens off the API.
JEV_MIN_SCORE_TO_EVALUATE=40
JEV_MIN_MCAP_TO_EVALUATE=30000
# Hard call caps. Daily resets at UTC midnight; total is a lifetime cap that
# survives restarts (persisted). Raise once you trust the spend rate.
JEV_MAX_CALLS_PER_DAY=400
JEV_MAX_CALLS_TOTAL=3000

# --- Blend weights (points at full confidence; scaled by Jev's confidence) ---
# Kept out of the model so you can retune from outcomes with no re-inference.
JEV_WEIGHT_NARRATIVE_QUALITY=12
JEV_WEIGHT_LEGITIMACY=12
JEV_WEIGHT_DURABILITY=10
# Impersonation-risk probability above this HARD-VETOES the score to 0.
JEV_IMPERSONATION_VETO=0.6

# --- Trap/rug risk (Noul over the enriched on-chain state) ---
# Jev now sees holder concentration, $1k+ positions, bundle flags, dev rug
# history, buy/sell pressure and momentum. It judges whether the picture looks
# like a coordinated pump/rug. Negative points up to JEV_WEIGHT_TRAP_RISK;
# above JEV_TRAP_RISK_VETO it hard-zeros the opportunity score.
JEV_WEIGHT_TRAP_RISK=20
JEV_TRAP_RISK_VETO=0.85

# --- PvP: same-name comparative pick + >$500k runner history ---
# When >= JEV_PVP_MIN_COHORT coins share a name across launchpads, Jev picks
# which one is the play (old vs new), grounded in past big runners on the chain.
BIG_RUNNER_MCAP_USD=500000
BIG_RUNNERS_MAX_PER_CHAIN=200
JEV_PVP_MIN_COHORT=2
JEV_WEIGHT_PVP_PICK=15
# PvP cost controls (it was over-firing): at least one same-name coin must have
# this mcap, and the same narrative won't be re-picked within the cooldown.
JEV_PVP_MIN_MCAP=20000
JEV_PVP_COOLDOWN_SECONDS=1800
# Jev judges upside-from-here for any LIVE coin (big or small) — a promising
# larger coin still climbing on a strong narrative stays a candidate. Only coins
# whose run is over (GRADUATED off the curve, or RUGGED) are excluded.
# Weight of the primary 'moon potential' judgment (confidence-scaled).
JEV_WEIGHT_MOON_POTENTIAL=18

# --- Jev auto-proposer (optional generative LLM that invents new candidate
# questions to test). OpenAI-compatible endpoint. Blank key => manual queue.
# Example uses DeepSeek. The proposer reads the current questions + which ones
# actually separate winners from losers, and proposes new ones to test live.
JEV_PROPOSER_LLM_KEY=
JEV_PROPOSER_LLM_URL=https://api.deepseek.com/chat/completions
JEV_PROPOSER_LLM_MODEL=deepseek-chat
JEV_PROPOSER_INTERVAL_SECONDS=3600
JEV_PROPOSER_MAX_NEW_PER_ROUND=2
# Seed known past big runners so history is useful on day one.
# Format: "chain:TICKER:platform" comma-separated. e.g.:
# BIG_RUNNERS_SEED=solana:OPTIMUS:pump.fun,solana:PEPE:pump.fun
BIG_RUNNERS_SEED=

# --- Birdeye (Solana enrichment/fallback for price/mcap/liquidity + holders) ---
# Free tier ~1 req/s; used only for gated candidates. Blank = disabled.
BIRDEYE_API_KEY=
BIRDEYE_MIN_INTERVAL_SECONDS=1.2
